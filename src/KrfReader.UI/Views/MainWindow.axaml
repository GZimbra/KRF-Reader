<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:KrfReader.UI.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="KrfReader.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="KRF Reader — Controle de Estoque RFID"
        Icon="/Assets/krf.ico"
        Width="1280" Height="860" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <Style Selector="Ellipse.led">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="Fill" Value="#DE4236" />
    </Style>
    <Style Selector="Ellipse.led.ok">
      <Setter Property="Fill" Value="#3DD68C" />
    </Style>
    <Style Selector="TextBlock.status">
      <Setter Property="Foreground" Value="{StaticResource SaidaTextBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.status.dentro">
      <Setter Property="Foreground" Value="{StaticResource EntradaTextBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{StaticResource SaidaTextBrush}" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- Cabeçalho da marca -->
    <Border Grid.Row="0" Background="{StaticResource BrandInkBrush}"
            BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="28,14">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="14">
        <Viewbox Grid.Column="0" Width="40" Height="40">
          <Canvas Width="64" Height="64">
            <Path Data="{StaticResource KrfMarkBody}" Fill="{StaticResource BrandOrangeBrush}" />
            <Path Data="{StaticResource KrfMarkWaves}" Stroke="{StaticResource BrandSandBrush}"
                  StrokeThickness="3.2" StrokeLineCap="Round" />
          </Canvas>
        </Viewbox>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="KRF" FontSize="24" FontWeight="ExtraBold" LetterSpacing="1" />
            <TextBlock Text="Reader" FontSize="24" FontWeight="Light" LetterSpacing="1" />
          </StackPanel>
          <TextBlock Classes="cardLabel" Text="CONTROLE DE ESTOQUE · RFID UHF" />
        </StackPanel>
        <Border Grid.Column="3" VerticalAlignment="Center" CornerRadius="2" Padding="12,6"
                Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Classes="led" Classes.ok="{Binding IsConnected}" VerticalAlignment="Center" Width="10" Height="10" />
            <TextBlock VerticalAlignment="Center" Classes="muted" Text="{Binding ReaderName}" />
            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding ConnectionText}" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <TabControl Grid.Row="1" Classes="nav" IsEnabled="{Binding !IsShuttingDown}">

      <!-- ═══════════════════════ OPERAÇÃO ═══════════════════════ -->
      <TabItem Header="OPERAÇÃO">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="10">

          <!-- Banner do modo -->
          <Border Grid.Row="0" Classes="banner"
                  Classes.entrada="{Binding IsEntradaActive}"
                  Classes.saida="{Binding IsSaidaActive}">
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Text="{Binding ModeBannerText}" FontSize="56" FontWeight="Black" LetterSpacing="4"
                         Foreground="White" HorizontalAlignment="Center" />
              <TextBlock Text="{Binding ModeBannerHint}" FontSize="18" Foreground="White"
                         HorizontalAlignment="Center" Opacity="0.9" />
            </StackPanel>
          </Border>

          <!-- Botões de modo -->
          <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="12">
            <Button Grid.Column="0" Classes="mode entrada" Classes.active="{Binding IsEntradaActive}"
                    Content="ENTRADA" Command="{Binding EntradaCommand}"
                    ToolTip.Tip="Tags lidas passam a DENTRO do estoque" />
            <Button Grid.Column="1" Classes="mode saida" Classes.active="{Binding IsSaidaActive}"
                    Content="SAÍDA" Command="{Binding SaidaCommand}"
                    ToolTip.Tip="Tags lidas passam a FORA do estoque" />
            <Button Grid.Column="2" Classes="mode parar" Classes.active="{Binding IsStopped}"
                    Content="PARAR" Command="{Binding PararCommand}"
                    ToolTip.Tip="Para o inventário e grava as leituras pendentes" />
          </Grid>

          <!-- Contadores -->
          <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*">
            <Border Grid.Column="0" Classes="card kpi" BorderBrush="{StaticResource EntradaTextBrush}">
              <StackPanel>
                <TextBlock Classes="cardLabel" Text="TAGS DENTRO" />
                <TextBlock Classes="cardValue" Foreground="{StaticResource EntradaTextBrush}" Text="{Binding CountDentro, StringFormat={}{0:N0}}" />
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="card kpi" BorderBrush="{StaticResource SaidaTextBrush}">
              <StackPanel>
                <TextBlock Classes="cardLabel" Text="TAGS FORA" />
                <TextBlock Classes="cardValue" Foreground="{StaticResource SaidaTextBrush}" Text="{Binding CountFora, StringFormat={}{0:N0}}" />
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Classes="card kpi" BorderBrush="{StaticResource BrandOrangeBrush}">
              <StackPanel>
                <TextBlock Classes="cardLabel" Text="LIDAS NESTA SESSÃO" />
                <TextBlock Classes="cardValue" Text="{Binding SessionDistinct, StringFormat={}{0:N0}}" />
              </StackPanel>
            </Border>
            <Border Grid.Column="3" Classes="card kpi" BorderBrush="{StaticResource BrandSandBrush}">
              <StackPanel>
                <TextBlock Classes="cardLabel" Text="ANOMALIAS · SAÍDA SEM ENTRADA" />
                <TextBlock Classes="cardValue" Foreground="{StaticResource BrandSandBrush}" Text="{Binding CountAnomalias, StringFormat={}{0:N0}}" />
              </StackPanel>
            </Border>
          </Grid>

          <TextBlock Grid.Row="3" Classes="muted" FontSize="12" Margin="6,0"
                     Text="{Binding TechStatsText}" TextWrapping="Wrap" />

          <!-- Lista ao vivo -->
          <Border Grid.Row="4" Classes="card" Margin="0" Padding="0">
            <Grid RowDefinitions="Auto,Auto,*">
              <DockPanel Grid.Row="0" Margin="16,10">
                <Button DockPanel.Dock="Right" Classes="ghost" Content="Limpar lista" Command="{Binding ClearLiveReadsCommand}" />
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                  <TextBlock Classes="sectionTitle" VerticalAlignment="Center" Text="LEITURAS AO VIVO" />
                  <TextBlock Classes="muted" VerticalAlignment="Center" FontSize="12"
                             Text="últimas 200 aplicadas, mais recente no topo" />
                </StackPanel>
              </DockPanel>
              <Grid Grid.Row="1" Margin="12,0,12,4" ColumnDefinitions="110,*,70,80,100,200">
                <TextBlock Grid.Column="0" Classes="header" Text="HORA" />
                <TextBlock Grid.Column="1" Classes="header" Text="EPC" />
                <TextBlock Grid.Column="2" Classes="header" Text="ANTENA" />
                <TextBlock Grid.Column="3" Classes="header" Text="RSSI" />
                <TextBlock Grid.Column="4" Classes="header" Text="MODO" />
                <TextBlock Grid.Column="5" Classes="header" Text="RESULTADO" />
              </Grid>
              <ListBox Grid.Row="2" Classes="compact" ItemsSource="{Binding LiveReads}" Background="Transparent">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:LiveReadItem">
                    <Border Classes="row" Classes.anomaly="{Binding IsAnomaly}" Padding="12,3">
                      <Grid ColumnDefinitions="110,*,70,80,100,200">
                        <TextBlock Grid.Column="0" Text="{Binding Time}" />
                        <TextBlock Grid.Column="1" Text="{Binding Epc}" FontFamily="Consolas,Menlo,DejaVu Sans Mono,monospace" />
                        <TextBlock Grid.Column="2" Text="{Binding Antenna}" />
                        <TextBlock Grid.Column="3" Text="{Binding Rssi}" />
                        <TextBlock Grid.Column="4" Text="{Binding Mode}" />
                        <TextBlock Grid.Column="5" Text="{Binding Result}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <!-- ═══════════════════════ CONSULTA ═══════════════════════ -->
      <TabItem Header="CONSULTA">
        <Grid RowDefinitions="Auto,Auto,*,Auto,*" RowSpacing="8">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Status:" VerticalAlignment="Center" />
            <ComboBox Width="140" ItemsSource="{Binding StatusFilterOptions}" SelectedIndex="{Binding StatusFilterIndex}" />
            <TextBlock Text="EPC contém:" VerticalAlignment="Center" Margin="12,0,0,0" />
            <TextBox Width="340" Text="{Binding SearchText}" Watermark="parte do EPC (opcional)">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
              </TextBox.KeyBindings>
            </TextBox>
            <Button Content="Buscar" Command="{Binding SearchCommand}" Classes="accent" />
          </StackPanel>

          <TextBlock Grid.Row="1" Classes="muted" Text="{Binding QueryMessage}" />

          <Border Grid.Row="2" Classes="card" Margin="0" Padding="0">
            <Grid RowDefinitions="Auto,*">
              <Grid Margin="12,8,12,4" ColumnDefinitions="*,110,200,200">
                <TextBlock Grid.Column="0" Classes="header" Text="EPC" />
                <TextBlock Grid.Column="1" Classes="header" Text="STATUS" />
                <TextBlock Grid.Column="2" Classes="header" Text="ÚLTIMA LEITURA" />
                <TextBlock Grid.Column="3" Classes="header" Text="ÚLTIMA MUDANÇA" />
              </Grid>
              <ListBox Grid.Row="1" Classes="compact" ItemsSource="{Binding Tags}"
                       SelectedItem="{Binding SelectedTag}" Background="Transparent">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:TagRowItem">
                    <Grid Margin="12,3" ColumnDefinitions="*,110,200,200">
                      <TextBlock Grid.Column="0" Text="{Binding Epc}" FontFamily="Consolas,Menlo,DejaVu Sans Mono,monospace" />
                      <TextBlock Grid.Column="1" Classes="status" Classes.dentro="{Binding IsDentro}" Text="{Binding Status}" />
                      <TextBlock Grid.Column="2" Text="{Binding UltimaLeitura}" />
                      <TextBlock Grid.Column="3" Text="{Binding UltimaMudanca}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

          <TextBlock Grid.Row="3" FontWeight="SemiBold" Foreground="{StaticResource BrandSandBrush}" Margin="4,6,0,0" Text="{Binding HistoryTitle}" />

          <Border Grid.Row="4" Classes="card" Margin="0" Padding="0">
            <Grid RowDefinitions="Auto,*">
              <Grid Margin="12,8,12,4" ColumnDefinitions="200,110,*,70,80">
                <TextBlock Grid.Column="0" Classes="header" Text="DATA/HORA" />
                <TextBlock Grid.Column="1" Classes="header" Text="MODO" />
                <TextBlock Grid.Column="2" Classes="header" Text="EVENTO" />
                <TextBlock Grid.Column="3" Classes="header" Text="ANTENA" />
                <TextBlock Grid.Column="4" Classes="header" Text="RSSI" />
              </Grid>
              <ListBox Grid.Row="1" Classes="compact" ItemsSource="{Binding Events}" Background="Transparent">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:EventRowItem">
                    <Border Classes="row" Classes.anomaly="{Binding IsAnomaly}" Padding="12,3">
                      <Grid ColumnDefinitions="200,110,*,70,80">
                        <TextBlock Grid.Column="0" Text="{Binding Time}" />
                        <TextBlock Grid.Column="1" Text="{Binding Mode}" />
                        <TextBlock Grid.Column="2" Text="{Binding Type}" />
                        <TextBlock Grid.Column="3" Text="{Binding Antenna}" />
                        <TextBlock Grid.Column="4" Text="{Binding Rssi}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <!-- ═══════════════════════ CONFIGURAÇÃO ═══════════════════════ -->
      <TabItem Header="CONFIGURAÇÃO">
        <ScrollViewer>
          <StackPanel Spacing="16" MaxWidth="760" HorizontalAlignment="Left">

            <!-- Leitor: exige reaplicar -->
            <Border Classes="card" Padding="20">
              <StackPanel Spacing="10">
                <TextBlock Classes="sectionTitle" Text="LEITOR RFID" />
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="Tipo, conexão, protocolo, potência e antenas só valem após clicar em &quot;Aplicar leitor&quot; (o leitor é desconectado e reconectado). Exige o modo PARADO." />

                <Grid ColumnDefinitions="180,*">
                  <TextBlock Text="Tipo de leitor" VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1" Width="260"
                            ItemsSource="{Binding ReaderTypes}" SelectedIndex="{Binding ReaderTypeIndex}" />
                </Grid>

                <Grid ColumnDefinitions="180,*" IsVisible="{Binding IsProtocolRelevant}">
                  <TextBlock Text="Protocolo" VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1" Width="260"
                            ItemsSource="{Binding Protocols}" SelectedItem="{Binding SelectedProtocol}" />
                </Grid>

                <Grid ColumnDefinitions="180,*" IsVisible="{Binding IsSerialSelected}">
                  <TextBlock Text="Porta serial / baud" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <TextBox Width="200" Text="{Binding SerialPortName}" Watermark="COM3 ou /dev/ttyUSB0" />
                    <NumericUpDown Width="170" Minimum="300" Maximum="921600" Increment="9600"
                                   FormatString="0" Value="{Binding BaudRate}" />
                  </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="180,*" IsVisible="{Binding IsTcpSelected}">
                  <TextBlock Text="Host / porta TCP" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <TextBox Width="200" Text="{Binding TcpHost}" Watermark="192.168.1.100" />
                    <NumericUpDown Width="170" Minimum="1" Maximum="65535" Increment="1"
                                   FormatString="0" Value="{Binding TcpPort}" />
                  </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="180,*">
                  <TextBlock Text="Potência (dBm)" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <NumericUpDown Width="170" Minimum="0" Maximum="33" Increment="1"
                                   FormatString="0" Value="{Binding PowerDbm}" />
                    <TextBlock Classes="muted" VerticalAlignment="Center" Text="0–33 dBm · controla o alcance (exige reaplicar)" />
                  </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="180,*">
                  <TextBlock Text="Antenas ativas" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <TextBox Width="200" Text="{Binding ReaderAntennasText}" Watermark="1,2" />
                    <TextBlock Classes="muted" VerticalAlignment="Center" Text="portas físicas ligadas no leitor" />
                  </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="12">
                  <Button Content="Aplicar leitor" Classes="accent" Command="{Binding ApplyReaderCommand}" />
                  <TextBlock VerticalAlignment="Center" Classes="error" IsVisible="{Binding IsModeActive}"
                             Text="Modo ativo: pressione PARAR antes de trocar o leitor." />
                </StackPanel>
                <TextBlock Text="{Binding ConfigMessage}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <!-- Filtro: ao vivo -->
            <Border Classes="card" Padding="20">
              <StackPanel Spacing="10">
                <TextBlock Classes="sectionTitle" Text="FILTRO DE LEITURAS · AO VIVO" />
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="Aplicado imediatamente, sem reconectar o leitor. Leituras com RSSI abaixo do mínimo ou de antenas fora da lista são ignoradas (corta leituras fantasma de tags distantes)." />

                <Grid ColumnDefinitions="180,*,90">
                  <TextBlock Text="RSSI mínimo" VerticalAlignment="Center" />
                  <Slider Grid.Column="1" Minimum="-100" Maximum="-20" TickFrequency="1"
                          IsSnapToTickEnabled="True" Value="{Binding MinRssi}" />
                  <TextBlock Grid.Column="2" Text="{Binding MinRssiText}" FontWeight="Bold"
                             VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>

                <Grid ColumnDefinitions="180,*">
                  <TextBlock Text="Antenas aceitas" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <TextBox Width="200" Text="{Binding FilterAntennasText}" Watermark="vazio = todas" />
                  </StackPanel>
                </Grid>
                <TextBlock Classes="muted" Text="{Binding FilterMessage}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <!-- Barra de status -->
    <Border Grid.Row="2" Background="{StaticResource BrandInkBrush}" BorderBrush="{StaticResource HairlineBrush}"
            BorderThickness="0,1,0,0" Padding="28,8">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock Grid.Column="0" VerticalAlignment="Center" Classes="muted" Text="{Binding StatusMessage}"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="error" MaxWidth="600"
                   TextTrimming="CharacterEllipsis" Text="{Binding LastError}"
                   ToolTip.Tip="{Binding LastError}" />
      </Grid>
    </Border>

    <!-- Overlay de encerramento -->
    <Border Grid.RowSpan="3" Background="#D0191919" IsVisible="{Binding IsShuttingDown}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
        <TextBlock Text="Encerrando..." FontSize="36" FontWeight="Bold" Foreground="{StaticResource BrandOrangeBrush}" HorizontalAlignment="Center" />
        <TextBlock Text="Gravando leituras pendentes no banco. Aguarde." Foreground="White" HorizontalAlignment="Center" />
        <ProgressBar IsIndeterminate="True" Width="300" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
