<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:KrfReader.UI.ViewModels"
        xmlns:c="using:KrfReader.UI.Controls"
        xmlns:readers="using:KrfReader.Application.Readers"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="860"
        x:Class="KrfReader.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="KRF Reader — Controle de Estoque RFID"
        Icon="/Assets/krf.ico"
        Width="1280" Height="860" MinWidth="1024" MinHeight="680"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <!-- Painel do modo: cor do texto principal acompanha o modo. -->
    <Style Selector="TextBlock.modeText">
      <Setter Property="Foreground" Value="{StaticResource BrandSandBrush}" />
    </Style>
    <Style Selector="TextBlock.modeText.entrada">
      <Setter Property="Foreground" Value="{StaticResource EntradaTextBrush}" />
    </Style>
    <Style Selector="TextBlock.modeText.saida">
      <Setter Property="Foreground" Value="{StaticResource SaidaTextBrush}" />
    </Style>
    <Style Selector="Border.modeBar">
      <Setter Property="Width" Value="4" />
      <Setter Property="Background" Value="{StaticResource BrandOrangeBrush}" />
    </Style>
    <Style Selector="Border.modeBar.entrada">
      <Setter Property="Background" Value="{StaticResource EntradaTextBrush}" />
    </Style>
    <Style Selector="Border.modeBar.saida">
      <Setter Property="Background" Value="{StaticResource SaidaTextBrush}" />
    </Style>
    <!-- Indicador "RX" piscando enquanto o leitor lê. -->
    <Style Selector="Border.rx">
      <Setter Property="Opacity" Value="0.25" />
    </Style>
    <Style Selector="Border.rx.on">
      <Style.Animations>
        <Animation Duration="0:0:1" IterationCount="Infinite">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="60%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="61%"><Setter Property="Opacity" Value="0.3" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.3" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <!-- Contadores -->
    <Style Selector="Border.kpi">
      <Setter Property="Background" Value="{StaticResource PanelBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,10" />
    </Style>
    <Style Selector="TextBlock.status">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="Foreground" Value="{StaticResource SaidaTextBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.status.nunca">
      <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
    </Style>
    <Style Selector="TextBlock.status.dentro">
      <Setter Property="Foreground" Value="{StaticResource EntradaTextBrush}" />
    </Style>
    <!-- Formulários: rótulo à esquerda, campo à direita -->
    <Style Selector="TextBlock.field">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="LetterSpacing" Value="1" />
      <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Veredito da passagem -->
    <Style Selector="Border.verdict">
      <Setter Property="Background" Value="{StaticResource PanelBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
      <Setter Property="BorderThickness" Value="1,1,1,3" />
      <Setter Property="Padding" Value="14,8" />
    </Style>
    <Style Selector="Border.verdict.ok">
      <Setter Property="BorderBrush" Value="{StaticResource EntradaTextBrush}" />
    </Style>
    <Style Selector="Border.verdict.warn">
      <Setter Property="BorderBrush" Value="{StaticResource BrandOrangeBrush}" />
    </Style>
    <Style Selector="Border.verdict.bad">
      <Setter Property="BorderBrush" Value="{StaticResource SaidaTextBrush}" />
    </Style>
    <Style Selector="TextBlock.verdictText">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="3" />
      <Setter Property="Foreground" Value="{StaticResource BrandSandBrush}" />
    </Style>
    <Style Selector="Border.verdict.ok TextBlock.verdictText">
      <Setter Property="Foreground" Value="{StaticResource EntradaTextBrush}" />
    </Style>
    <Style Selector="Border.verdict.warn TextBlock.verdictText">
      <Setter Property="Foreground" Value="{StaticResource BrandOrangeBrush}" />
    </Style>
    <Style Selector="Border.verdict.bad TextBlock.verdictText">
      <Setter Property="Foreground" Value="{StaticResource SaidaTextBrush}" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- ══════════════ Cabeçalho: marca · escala UHF · link ══════════════ -->
    <Border Grid.Row="0" Background="{StaticResource BrandInkBrush}"
            BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="24,12">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="20">
        <Viewbox Grid.Column="0" Width="38" Height="38">
          <Canvas Width="64" Height="64">
            <Path Data="{StaticResource KrfMarkBody}" Fill="{StaticResource BrandOrangeBrush}" />
            <Path Data="{StaticResource KrfMarkWaves}" Stroke="{StaticResource BrandSandBrush}"
                  StrokeThickness="3.2" StrokeLineCap="Round" />
          </Canvas>
        </Viewbox>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
          <StackPanel Orientation="Horizontal" Spacing="0">
            <TextBlock Text="KRF" FontFamily="{StaticResource MonoFont}" FontSize="22" FontWeight="Bold" LetterSpacing="3" />
            <TextBlock Text="/READER" FontFamily="{StaticResource MonoFont}" FontSize="22" LetterSpacing="3"
                       Foreground="{StaticResource MutedTextBrush}" />
          </StackPanel>
          <TextBlock Classes="label" Text="RFID UHF · ESTOQUE" />
        </StackPanel>

        <!-- Escala de sintonia -->
        <Grid Grid.Column="2" ColumnDefinitions="Auto,*" ColumnSpacing="10" MaxWidth="560"
              HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="12,0">
          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock Classes="label" Text="UHF" />
            <TextBlock Classes="label" Text="MHz" />
          </StackPanel>
          <c:FrequencyScale Grid.Column="1" Height="30" IsLive="{Binding IsReading}"
                            BandMinimum="{Binding BandMinimum}" BandMaximum="{Binding BandMaximum}"
                            ToolTip.Tip="Banda UHF. Faixa destacada = configurada no leitor. Acende com o inventário rodando." />
        </Grid>

        <!-- Link com o leitor -->
        <Border Grid.Column="3" Classes="screen" VerticalAlignment="Center" Padding="12,6">
          <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="12">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Ellipse Classes="led" Classes.ok="{Binding IsConnected}" VerticalAlignment="Center" />
              <TextBlock Classes="label" Text="LINK" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Classes="mono" FontSize="12" FontWeight="SemiBold" Text="{Binding ConnectionText}" />
              <TextBlock Classes="mono dim" FontSize="10" Text="{Binding ReaderName}" />
            </StackPanel>
            <Border Grid.Column="2" Classes="rx" Classes.on="{Binding IsReading}" VerticalAlignment="Center"
                    BorderBrush="{StaticResource BrandOrangeBrush}" BorderThickness="1" Padding="5,1">
              <TextBlock Classes="mono" FontSize="10" FontWeight="Bold" Text="RX"
                         Foreground="{StaticResource BrandOrangeBrush}" />
            </Border>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <TabControl Grid.Row="1" Classes="nav" IsEnabled="{Binding !IsShuttingDown}"
                SelectedIndex="{Binding SelectedTabIndex}">

      <!-- ═══════════════════════ OPERAÇÃO ═══════════════════════ -->
      <TabItem Header="01 OPERAÇÃO">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="10">

          <!-- Modo + instrumentos -->
          <Grid Grid.Row="0" ColumnDefinitions="*,320" ColumnSpacing="10">
            <c:HudBorder Grid.Column="0" Classes="card" Padding="0"
                         Classes.entrada="{Binding IsEntradaActive}" Classes.saida="{Binding IsSaidaActive}">
              <Grid ColumnDefinitions="Auto,*">
                <Border Grid.Column="0" Classes="modeBar"
                        Classes.entrada="{Binding IsEntradaActive}" Classes.saida="{Binding IsSaidaActive}" />
                <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" Margin="18,12,18,14" RowSpacing="6">
                  <DockPanel Grid.Row="0">
                    <TextBlock DockPanel.Dock="Right" Classes="label" Text="LEITURAS/S · ÚLTIMOS 12 s" />
                    <TextBlock Classes="label sand" Text="MODO" />
                  </DockPanel>
                  <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="18">
                    <TextBlock Classes="modeText" Classes.entrada="{Binding IsEntradaActive}" Classes.saida="{Binding IsSaidaActive}"
                               Text="{Binding ModeBannerText}" FontFamily="{StaticResource MonoFont}"
                               FontSize="44" FontWeight="Bold" LetterSpacing="8" />
                    <TextBlock VerticalAlignment="Center" Margin="0,8,0,0" Classes="mono muted" FontSize="13"
                               Text="{Binding ModeBannerHint}" />
                  </StackPanel>
                  <Border Grid.Row="2" Classes="screen" MinHeight="92">
                    <c:Oscilloscope Level="{Binding SignalLevel}" IsLive="{Binding IsReading}"
                                    Classes.entrada="{Binding IsEntradaActive}" Classes.saida="{Binding IsSaidaActive}" />
                  </Border>
                </Grid>
              </Grid>
            </c:HudBorder>

            <c:HudBorder Grid.Column="1" Classes="card" Padding="16,12">
              <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
                <DockPanel Grid.Row="0">
                  <TextBlock DockPanel.Dock="Right" Classes="mono" FontSize="13" FontWeight="Bold"
                             Text="{Binding ReadRateText}" />
                  <TextBlock Classes="label sand" Text="LEITURAS/s" />
                </DockPanel>
                <c:VuDial Grid.Row="1" Height="96" Value="{Binding ReadRate}"
                          Maximum="{x:Static vm:MainWindowViewModel.ReadRateScale}"
                          ToolTip.Tip="Leituras brutas por segundo, antes do filtro e da deduplicação" />
                <DockPanel Grid.Row="2" Margin="0,8,0,0">
                  <TextBlock DockPanel.Dock="Right" Classes="mono" FontSize="13" FontWeight="Bold">
                    <Run Text="{Binding LastRssiText}" /><Run Text=" dBm" Foreground="{StaticResource DimTextBrush}" FontWeight="Normal" />
                  </TextBlock>
                  <TextBlock Classes="label sand" Text="RSSI" />
                </DockPanel>
                <c:SignalMeter Grid.Row="3" Height="30" Value="{Binding LastRssi}" Threshold="{Binding MinRssi}"
                               Segments="32"
                               ToolTip.Tip="Sinal mais forte do último intervalo. Marca laranja = RSSI mínimo do filtro." />
              </Grid>
            </c:HudBorder>
          </Grid>

          <!-- Teclas de modo -->
          <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
            <Button Grid.Column="0" Classes="key entrada" Classes.active="{Binding IsEntradaActive}"
                    Command="{Binding EntradaCommand}" ToolTip.Tip="Tags lidas passam a DENTRO do estoque">
              <DockPanel>
                <Border DockPanel.Dock="Top" Classes="keyLed" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                  <TextBlock HorizontalAlignment="Center" FontSize="20" FontWeight="Bold" LetterSpacing="4" Text="▲ ENTRADA" />
                  <TextBlock HorizontalAlignment="Center" FontSize="10" LetterSpacing="2" Opacity="0.7" Text="→ DENTRO" />
                </StackPanel>
              </DockPanel>
            </Button>
            <Button Grid.Column="1" Classes="key saida" Classes.active="{Binding IsSaidaActive}"
                    Command="{Binding SaidaCommand}" ToolTip.Tip="Tags lidas passam a FORA do estoque">
              <DockPanel>
                <Border DockPanel.Dock="Top" Classes="keyLed" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                  <TextBlock HorizontalAlignment="Center" FontSize="20" FontWeight="Bold" LetterSpacing="4" Text="▼ SAÍDA" />
                  <TextBlock HorizontalAlignment="Center" FontSize="10" LetterSpacing="2" Opacity="0.7" Text="→ FORA" />
                </StackPanel>
              </DockPanel>
            </Button>
            <Button Grid.Column="2" Classes="key docas" Classes.active="{Binding IsDocksActive}"
                    Command="{Binding DocasCommand}"
                    ToolTip.Tip="Entrada e saída ao mesmo tempo: a antena que leu define a direção (leitor multiporta, docas em Configuração)">
              <DockPanel>
                <Border DockPanel.Dock="Top" Classes="keyLed" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                  <TextBlock HorizontalAlignment="Center" FontSize="20" FontWeight="Bold" LetterSpacing="4" Text="▲▼ DOCAS" />
                  <TextBlock HorizontalAlignment="Center" FontSize="10" LetterSpacing="2" Opacity="0.7" Text="{Binding DocksKeyHint}" />
                </StackPanel>
              </DockPanel>
            </Button>
            <Button Grid.Column="3" Classes="key parar" Classes.active="{Binding IsStopped}"
                    Command="{Binding PararCommand}" ToolTip.Tip="Para o inventário e grava as leituras pendentes">
              <DockPanel>
                <Border DockPanel.Dock="Top" Classes="keyLed" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                  <TextBlock HorizontalAlignment="Center" FontSize="20" FontWeight="Bold" LetterSpacing="4" Text="■ PARAR" />
                  <TextBlock HorizontalAlignment="Center" FontSize="10" LetterSpacing="2" Opacity="0.7" Text="NÃO GRAVA" />
                </StackPanel>
              </DockPanel>
            </Button>
          </Grid>

          <!-- Contadores -->
          <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
            <Border Grid.Column="0" Classes="kpi">
              <DockPanel>
                <Border DockPanel.Dock="Left" Width="2" Margin="0,0,12,0" Background="{StaticResource EntradaTextBrush}" />
                <StackPanel>
                  <TextBlock Classes="label" Text="CH1 · DENTRO" />
                  <TextBlock Classes="readout entrada" Text="{Binding CountDentro, StringFormat={}{0:N0}}" />
                </StackPanel>
              </DockPanel>
            </Border>
            <Border Grid.Column="1" Classes="kpi">
              <DockPanel>
                <Border DockPanel.Dock="Left" Width="2" Margin="0,0,12,0" Background="{StaticResource SaidaTextBrush}" />
                <StackPanel>
                  <TextBlock Classes="label" Text="CH2 · FORA" />
                  <TextBlock Classes="readout saida" Text="{Binding CountFora, StringFormat={}{0:N0}}" />
                </StackPanel>
              </DockPanel>
            </Border>
            <Border Grid.Column="2" Classes="kpi">
              <DockPanel>
                <Border DockPanel.Dock="Left" Width="2" Margin="0,0,12,0" Background="{StaticResource BrandOrangeBrush}" />
                <StackPanel>
                  <TextBlock Classes="label" Text="CH3 · LIDAS NA SESSÃO" />
                  <TextBlock Classes="readout" Text="{Binding SessionDistinct, StringFormat={}{0:N0}}" />
                </StackPanel>
              </DockPanel>
            </Border>
            <Border Grid.Column="3" Classes="kpi">
              <DockPanel>
                <Border DockPanel.Dock="Left" Width="2" Margin="0,0,12,0" Background="{StaticResource BrandSandBrush}" />
                <StackPanel>
                  <TextBlock Classes="label" Text="CH4 · SAÍDA SEM ENTRADA" />
                  <TextBlock Classes="readout" Foreground="{StaticResource BrandSandBrush}"
                             Text="{Binding CountAnomalias, StringFormat={}{0:N0}}" />
                </StackPanel>
              </DockPanel>
            </Border>
          </Grid>

          <TextBlock Grid.Row="3" Classes="mono dim" FontSize="11" Margin="2,0"
                     Text="{Binding TechStatsText}" TextWrapping="Wrap" />

          <!-- Passagem (alta densidade) + lista ao vivo -->
          <Grid Grid.Row="4" ColumnDefinitions="3*,2*" ColumnSpacing="10">
            <c:HudBorder Grid.Column="0" Classes="card" Padding="0"
                         Classes.entrada="{Binding IsEntradaActive}" Classes.saida="{Binding IsSaidaActive}">
              <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">
                <StackPanel Grid.Row="0" Margin="14,8,14,4" Spacing="2">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Classes="label" VerticalAlignment="Center" Text="{Binding PassageStateText}" />
                    <TextBlock Classes="sectionTitle" VerticalAlignment="Center" Text="{Binding PassageTitle}" />
                  </DockPanel>
                  <TextBlock Classes="mono" FontSize="11" Foreground="{StaticResource BrandOrangeBrush}" TextWrapping="Wrap"
                             IsVisible="{Binding OtherPassageText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                             Text="{Binding OtherPassageText}" />
                </StackPanel>

                <!-- Veredito + métricas -->
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,*,*,*" ColumnSpacing="10" Margin="14,2,14,6">
                  <Border Grid.Column="0" Classes="verdict" MinWidth="220"
                          Classes.ok="{Binding IsVerdictOk}" Classes.warn="{Binding IsVerdictWarn}" Classes.bad="{Binding IsVerdictBad}">
                    <StackPanel Spacing="2">
                      <TextBlock Classes="label" Text="VEREDITO" />
                      <TextBlock Classes="verdictText" Text="{Binding VerdictText}" />
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="1" Classes="kpi"
                          ToolTip.Tip="Itens distintos nesta passagem: embalagem conta 1 (qualquer etiqueta lida) + tags avulsas. Etiquetas lidas: ver detalhe abaixo.">
                    <StackPanel>
                      <TextBlock Classes="label" Text="ITENS" />
                      <TextBlock Classes="readout" Text="{Binding PassageTagCount, StringFormat={}{0:N0}}" />
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="2" Classes="kpi"
                          ToolTip.Tip="Rodadas seguidas, com leitura, sem nenhum item novo. A passagem só é confiável quando atinge o mínimo.">
                    <StackPanel>
                      <TextBlock Classes="label" Text="ESTÁVEIS" />
                      <TextBlock Classes="readout" Text="{Binding PassageStableText}" />
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="3" Classes="kpi"
                          ToolTip.Tip="Itens provavelmente não lidos (estimador Chao2: itens vistos em 1 e em 2 rodadas; embalagem conta pela soma das faces)">
                    <StackPanel>
                      <TextBlock Classes="label" Text="NÃO LIDAS EST." />
                      <TextBlock Classes="readout" Foreground="{StaticResource BrandSandBrush}" Text="{Binding PassageMissedText}" />
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="4" Classes="kpi" ToolTip.Tip="Leituras aceitas (com releituras) nesta passagem">
                    <StackPanel>
                      <TextBlock Classes="label" Text="LEITURAS" />
                      <TextBlock Classes="readout" Text="{Binding PassageReads, StringFormat={}{0:N0}}" />
                    </StackPanel>
                  </Border>
                </Grid>

                <StackPanel Grid.Row="2" Margin="14,0,14,4" Spacing="2">
                  <TextBlock Classes="hint" Text="{Binding VerdictHint}" />
                  <TextBlock Classes="mono dim" FontSize="11" Text="{Binding PassageDetailText}" TextWrapping="Wrap" />
                  <TextBlock Classes="mono" FontSize="11" Foreground="{StaticResource BrandOrangeBrush}"
                             Text="{Binding InventoryControlText}" TextWrapping="Wrap" />
                  <TextBlock Classes="error" FontSize="12" Text="{Binding PassageIssuesText}" TextWrapping="Wrap"
                             IsVisible="{Binding PassageIssuesText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>

                <Border Grid.Row="3" Classes="tableHeader">
                  <Grid ColumnDefinitions="*,60,70,150,100">
                    <TextBlock Grid.Column="0" Classes="header" Text="EMBALAGEM · EPC" />
                    <TextBlock Grid.Column="1" Classes="header" Text="LEIT." />
                    <TextBlock Grid.Column="2" Classes="header" Text="RODADAS" />
                    <TextBlock Grid.Column="3" Classes="header" Text="RSSI MÁX dBm" />
                    <TextBlock Grid.Column="4" Classes="header" Text="SINAL" />
                  </Grid>
                </Border>
                <TextBlock Grid.Row="4" Classes="hint" Margin="14,10" IsVisible="{Binding !HasPassage}"
                           Text="Nenhuma passagem ainda. Tags marginais (uma rodada só ou RSSI no limite) aparecem no topo." />
                <ListBox Grid.Row="5" Classes="compact" ItemsSource="{Binding PassageTags}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:PassageTagRow">
                      <Border Classes="row" Classes.anomaly="{Binding IsMarginal}">
                        <Grid ColumnDefinitions="*,60,70,150,100">
                          <TextBlock Grid.Column="0" Text="{Binding Epc}" />
                          <TextBlock Grid.Column="1" Text="{Binding Reads}" />
                          <TextBlock Grid.Column="2" Text="{Binding Rounds}" />
                          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                            <TextBlock Width="44" Text="{Binding MaxRssi}" />
                            <c:SignalMeter Width="80" Height="8" VerticalAlignment="Center" ShowScale="False"
                                           Segments="12" Value="{Binding MaxRssiValue}" />
                          </StackPanel>
                          <TextBlock Grid.Column="4" Text="{Binding Flag}" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </c:HudBorder>

            <!-- Lista ao vivo -->
            <Border Grid.Column="1" Classes="card" Padding="0">
              <Grid RowDefinitions="Auto,Auto,*">
                <DockPanel Grid.Row="0" Margin="14,8">
                  <Button DockPanel.Dock="Right" Classes="ghost" Content="LIMPAR" Command="{Binding ClearLiveReadsCommand}" />
                  <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="12">
                    <TextBlock Classes="sectionTitle" VerticalAlignment="Center" Text="GRAVADAS NO ESTOQUE" />
                    <TextBlock Classes="label" VerticalAlignment="Center" Text="ÚLTIMAS 200" />
                  </StackPanel>
                </DockPanel>
                <Border Grid.Row="1" Classes="tableHeader">
                  <Grid ColumnDefinitions="100,*,52,130">
                    <TextBlock Grid.Column="0" Classes="header" Text="HORA" />
                    <TextBlock Grid.Column="1" Classes="header" Text="EMBALAGEM · EPC" />
                    <TextBlock Grid.Column="2" Classes="header" Text="RSSI" />
                    <TextBlock Grid.Column="3" Classes="header" Text="RESULTADO" />
                  </Grid>
                </Border>
                <ListBox Grid.Row="2" Classes="compact" ItemsSource="{Binding LiveReads}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:LiveReadItem">
                      <Border Classes="row" Classes.anomaly="{Binding IsAnomaly}">
                        <Grid ColumnDefinitions="100,*,52,130">
                          <TextBlock Grid.Column="0" Classes="dim" Text="{Binding Time}" />
                          <TextBlock Grid.Column="1" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="2" Text="{Binding Rssi}" />
                          <TextBlock Grid.Column="3" Text="{Binding Result}" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </TabItem>

      <!-- ═══════════════════════ CONSULTA ═══════════════════════ -->
      <TabItem Header="02 CONSULTA">
        <Grid RowDefinitions="Auto,*,Auto,*" RowSpacing="10">
          <Border Grid.Row="0" Classes="card" Padding="14,10">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Classes="mono muted" FontSize="12" VerticalAlignment="Center"
                         Text="{Binding QueryMessage}" />
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Classes="field" Text="STATUS" />
                <ComboBox Width="130" ItemsSource="{Binding StatusFilterOptions}" SelectedIndex="{Binding StatusFilterIndex}" />
                <TextBlock Classes="field" Text="BUSCA" Margin="8,0,0,0" />
                <TextBox Width="340" Text="{Binding SearchText}" Watermark="EPC, descrição ou SKU">
                  <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
                  </TextBox.KeyBindings>
                </TextBox>
                <Button Content="BUSCAR" Command="{Binding SearchCommand}" Classes="accent" />
              </StackPanel>
            </DockPanel>
          </Border>

          <Border Grid.Row="1" Classes="card" Padding="0">
            <Grid RowDefinitions="Auto,*">
              <Border Grid.Row="0" Classes="tableHeader">
                <Grid ColumnDefinitions="2*,2*,100,170,170">
                  <TextBlock Grid.Column="0" Classes="header" Text="EPC" />
                  <TextBlock Grid.Column="1" Classes="header" Text="DESCRIÇÃO" />
                  <TextBlock Grid.Column="2" Classes="header" Text="STATUS" />
                  <TextBlock Grid.Column="3" Classes="header" Text="ÚLTIMA LEITURA" />
                  <TextBlock Grid.Column="4" Classes="header" Text="ÚLTIMA MUDANÇA" />
                </Grid>
              </Border>
              <ListBox Grid.Row="1" Classes="compact" ItemsSource="{Binding Tags}" SelectedItem="{Binding SelectedTag}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:TagRowItem">
                    <Border Classes="row">
                      <Grid ColumnDefinitions="2*,2*,100,170,170">
                        <TextBlock Grid.Column="0" Text="{Binding Epc}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1" Text="{Binding Descricao}" Classes.dim="{Binding !IsRegistered}"
                                   FontFamily="{StaticResource ContentControlThemeFontFamily}" FontSize="13"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="2" Classes="status" Classes.dentro="{Binding IsDentro}" Text="{Binding Status}" />
                        <TextBlock Grid.Column="3" Classes="muted" Text="{Binding UltimaLeitura}" />
                        <TextBlock Grid.Column="4" Classes="muted" Text="{Binding UltimaMudanca}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

          <DockPanel Grid.Row="2">
            <Button DockPanel.Dock="Right" Classes="ghost" Content="CADASTRO DESTA TAG"
                    Command="{Binding RegisterSelectedTagCommand}"
                    IsEnabled="{Binding SelectedTag, Converter={x:Static ObjectConverters.IsNotNull}}"
                    ToolTip.Tip="Abre a tag selecionada na aba Cadastro (novo cadastro ou edição)" />
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <TextBlock Classes="sectionTitle" VerticalAlignment="Center" Text="HISTÓRICO" />
              <TextBlock Classes="mono muted" FontSize="12" VerticalAlignment="Center" Text="{Binding HistoryTitle}" />
            </StackPanel>
          </DockPanel>

          <Border Grid.Row="3" Classes="card" Padding="0">
            <Grid RowDefinitions="Auto,*">
              <Border Grid.Row="0" Classes="tableHeader">
                <Grid ColumnDefinitions="180,100,*,60,80">
                  <TextBlock Grid.Column="0" Classes="header" Text="DATA/HORA" />
                  <TextBlock Grid.Column="1" Classes="header" Text="MODO" />
                  <TextBlock Grid.Column="2" Classes="header" Text="EVENTO" />
                  <TextBlock Grid.Column="3" Classes="header" Text="ANT" />
                  <TextBlock Grid.Column="4" Classes="header" Text="RSSI" />
                </Grid>
              </Border>
              <ListBox Grid.Row="1" Classes="compact" ItemsSource="{Binding Events}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:EventRowItem">
                    <Border Classes="row" Classes.anomaly="{Binding IsAnomaly}">
                      <Grid ColumnDefinitions="180,100,*,60,80">
                        <TextBlock Grid.Column="0" Classes="muted" Text="{Binding Time}" />
                        <TextBlock Grid.Column="1" Text="{Binding Mode}" />
                        <TextBlock Grid.Column="2" Text="{Binding Type}" />
                        <TextBlock Grid.Column="3" Text="{Binding Antenna}" />
                        <TextBlock Grid.Column="4" Text="{Binding Rssi}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <!-- ═══════════════════════ MOVIMENTAÇÕES ═══════════════════════ -->
      <TabItem Header="03 MOVIMENTAÇÕES">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10" DataContext="{Binding Movimentacoes}" x:DataType="vm:StockMovementsViewModel">
          <Border Grid.Row="0" Classes="card" Padding="14,10">
            <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="8">
              <TextBlock Classes="field" Text="DE" VerticalAlignment="Center" />
              <CalendarDatePicker Width="150" SelectedDate="{Binding FromDate}" SelectedDateFormat="Short" />
              <TextBlock Classes="field" Text="ATÉ" VerticalAlignment="Center" />
              <CalendarDatePicker Width="150" SelectedDate="{Binding ToDate}" SelectedDateFormat="Short" />
              <Button Classes="ghost" Content="HOJE" Command="{Binding TodayCommand}" />
              <Button Classes="ghost" Content="7 DIAS" Command="{Binding Last7DaysCommand}" />
              <Button Classes="ghost" Content="30 DIAS" Command="{Binding Last30DaysCommand}" />
              <TextBlock Classes="field" Text="TIPO" Margin="8,0,0,0" VerticalAlignment="Center" />
              <ComboBox Width="130" ItemsSource="{Binding TipoOptions}" SelectedIndex="{Binding TipoIndex}" />
              <TextBlock Classes="field" Text="BUSCA" Margin="8,0,0,0" VerticalAlignment="Center" />
              <TextBox Width="260" Text="{Binding SearchText}" Watermark="EPC, descrição ou SKU">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
                </TextBox.KeyBindings>
              </TextBox>
              <Button Content="BUSCAR" Command="{Binding SearchCommand}" Classes="accent" />
            </WrapPanel>
          </Border>

          <DockPanel Grid.Row="1">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
              <TextBlock Classes="mono" FontSize="12" Foreground="{StaticResource EntradaTextBrush}"
                         Text="{Binding CountEntradas, StringFormat='ENTRADAS {0}'}" />
              <TextBlock Classes="mono" FontSize="12" Foreground="{StaticResource SaidaTextBrush}"
                         Text="{Binding CountSaidas, StringFormat='SAÍDAS {0}'}" />
              <TextBlock Classes="mono" FontSize="12" Foreground="{StaticResource BrandOrangeBrush}"
                         Text="{Binding CountAnomalias, StringFormat='ANOMALIAS {0}'}" />
            </StackPanel>
            <TextBlock Classes="mono muted" FontSize="12" VerticalAlignment="Center" Text="{Binding Message}"
                       Classes.error="{Binding MessageIsError}" />
          </DockPanel>

          <Border Grid.Row="2" Classes="card" Padding="0">
            <Grid RowDefinitions="Auto,*">
              <Border Grid.Row="0" Classes="tableHeader">
                <Grid ColumnDefinitions="170,90,2*,2*,170,50,70,80">
                  <TextBlock Grid.Column="0" Classes="header" Text="DATA/HORA" />
                  <TextBlock Grid.Column="1" Classes="header" Text="TIPO" />
                  <TextBlock Grid.Column="2" Classes="header" Text="EPC" />
                  <TextBlock Grid.Column="3" Classes="header" Text="ITEM" />
                  <TextBlock Grid.Column="4" Classes="header" Text="EVENTO" />
                  <TextBlock Grid.Column="5" Classes="header" Text="ANT" />
                  <TextBlock Grid.Column="6" Classes="header" Text="RSSI" />
                  <TextBlock Grid.Column="7" Classes="header" Text="PASSAGEM" />
                </Grid>
              </Border>
              <ListBox Grid.Row="1" Classes="compact" ItemsSource="{Binding Movements}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:MovementRowItem">
                    <Border Classes="row" Classes.anomaly="{Binding IsAnomaly}">
                      <Grid ColumnDefinitions="170,90,2*,2*,170,50,70,80">
                        <TextBlock Grid.Column="0" Classes="muted" Text="{Binding Time}" />
                        <TextBlock Grid.Column="1" Classes="status" Classes.dentro="{Binding IsEntrada}" Text="{Binding Tipo}" />
                        <TextBlock Grid.Column="2" Text="{Binding Epc}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="3" Text="{Binding Item}" Classes.dim="{Binding !IsRegistered}"
                                   FontFamily="{StaticResource ContentControlThemeFontFamily}" FontSize="13"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="4" Text="{Binding Evento}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="5" Text="{Binding Antenna}" />
                        <TextBlock Grid.Column="6" Text="{Binding Rssi}" />
                        <TextBlock Grid.Column="7" Classes="muted" Text="{Binding Passagem}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <!-- ═══════════════════════ CADASTRO ═══════════════════════ -->
      <TabItem Header="04 CADASTRO">
        <Grid ColumnDefinitions="420,*" ColumnSpacing="10" DataContext="{Binding Cadastro}" x:DataType="vm:TagCatalogViewModel">

          <!-- Formulário -->
          <ScrollViewer Grid.Column="0">
            <c:HudBorder Classes="card" Padding="20">
              <StackPanel Spacing="8">
                <DockPanel Margin="0,0,0,6">
                  <Button DockPanel.Dock="Right" Classes="ghost" Content="NOVA" Command="{Binding NewCommand}"
                          ToolTip.Tip="Limpa o formulário para um novo cadastro" />
                  <TextBlock Classes="sectionTitle" VerticalAlignment="Center" Text="{Binding FormTitle}" />
                </DockPanel>

                <TextBlock Classes="label" Text="EPC *" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBox Grid.Column="0" Classes="mono" Text="{Binding Epc}" IsReadOnly="{Binding IsEditing}"
                           Watermark="E28011606000020812345678" />
                  <Button Grid.Column="1" Classes="accent" Content="LER TAG" Command="{Binding CaptureCommand}"
                          ToolTip.Tip="Liga o leitor por 1,5 s e preenche o EPC da tag mais próxima. Exige o modo PARADO; não altera o estoque." />
                </Grid>
                <TextBlock Classes="hint" FontSize="11"
                           Text="Hexadecimal, múltiplo de 4 dígitos (EPC-96 = 24). Espaços, '-' e ':' são ignorados." />

                <Border Classes="screen" IsVisible="{Binding HasCapturedTags}">
                  <ListBox Classes="compact" ItemsSource="{Binding CapturedTags}" SelectedItem="{Binding SelectedCapturedTag}"
                           MaxHeight="160">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:CapturedTagItem">
                        <StackPanel Margin="10,4">
                          <TextBlock Classes="mono" Text="{Binding Epc}" />
                          <TextBlock Classes="mono dim" FontSize="11" Text="{Binding Detail}" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Border>

                <TextBlock Classes="label" Text="DESCRIÇÃO *" Margin="0,6,0,0" />
                <TextBox Text="{Binding Descricao}" MaxLength="200" Watermark="ex.: Palete 1,2 m · Cliente X" />

                <TextBlock Classes="label" Text="SKU / CÓDIGO DO ITEM" Margin="0,6,0,0" />
                <TextBox Classes="mono" Text="{Binding Sku}" MaxLength="64" Watermark="opcional" />

                <Grid ColumnDefinitions="*,110" ColumnSpacing="8" Margin="0,6,0,0">
                  <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Classes="label" Text="CATEGORIA" />
                    <TextBox Text="{Binding Categoria}" MaxLength="64" Watermark="opcional" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Classes="label" Text="UNIDADE" />
                    <TextBox Classes="mono" Text="{Binding Unidade}" MaxLength="16" Watermark="UN, CX, PL" />
                  </StackPanel>
                </Grid>

                <TextBlock Classes="label" Text="LOCALIZAÇÃO" Margin="0,6,0,0" />
                <TextBox Text="{Binding Localizacao}" MaxLength="100" Watermark="ex.: Rua A · Prateleira 3" />

                <TextBlock Classes="label" Text="OBSERVAÇÃO" Margin="0,6,0,0" />
                <TextBox Text="{Binding Observacao}" MaxLength="500" AcceptsReturn="True" TextWrapping="Wrap"
                         Height="80" Watermark="opcional" />

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                  <Button Classes="accent" Content="{Binding SaveLabel}" Command="{Binding SaveCommand}" />
                  <Button Classes="ghost" Content="REMOVER CADASTRO" Command="{Binding DeleteCommand}"
                          IsVisible="{Binding IsEditing}"
                          ToolTip.Tip="Remove só o cadastro. Status e histórico de leituras da tag são mantidos." />
                </StackPanel>

                <TextBlock Classes="mono" FontSize="12" Text="{Binding FormMessage}" TextWrapping="Wrap"
                           Classes.error="{Binding FormMessageIsError}" />
              </StackPanel>
            </c:HudBorder>
          </ScrollViewer>

          <!-- Lista -->
          <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="10">
            <Border Grid.Row="0" Classes="card" Padding="14,10">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Classes="mono muted" FontSize="12" VerticalAlignment="Center"
                           Text="{Binding ListMessage}" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Classes="field" Text="STATUS" />
                  <ComboBox Width="140" ItemsSource="{Binding StatusFilterOptions}" SelectedIndex="{Binding StatusFilterIndex}" />
                  <TextBlock Classes="field" Text="BUSCA" Margin="8,0,0,0" />
                  <TextBox Width="260" Text="{Binding SearchText}" Watermark="EPC, item, categoria, local">
                    <TextBox.KeyBindings>
                      <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
                    </TextBox.KeyBindings>
                  </TextBox>
                  <Button Content="BUSCAR" Command="{Binding SearchCommand}" Classes="accent" />
                </StackPanel>
              </DockPanel>
            </Border>

            <Border Grid.Row="1" Classes="card" Padding="0">
              <Grid RowDefinitions="Auto,*">
                <Border Grid.Row="0" Classes="tableHeader">
                  <Grid ColumnDefinitions="2*,2*,*,*,100,170">
                    <TextBlock Grid.Column="0" Classes="header" Text="EPC" />
                    <TextBlock Grid.Column="1" Classes="header" Text="DESCRIÇÃO" />
                    <TextBlock Grid.Column="2" Classes="header" Text="SKU" />
                    <TextBlock Grid.Column="3" Classes="header" Text="LOCAL" />
                    <TextBlock Grid.Column="4" Classes="header" Text="STATUS" />
                    <TextBlock Grid.Column="5" Classes="header" Text="ÚLTIMA DETECÇÃO" />
                  </Grid>
                </Border>
                <ListBox Grid.Row="1" Classes="compact" ItemsSource="{Binding Registrations}"
                         SelectedItem="{Binding SelectedRegistration}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:TagRegistrationItem">
                      <Border Classes="row">
                        <Grid ColumnDefinitions="2*,2*,*,*,100,170">
                          <TextBlock Grid.Column="0" Text="{Binding Epc}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                          <TextBlock Grid.Column="1" Text="{Binding Descricao}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"
                                     FontFamily="{StaticResource ContentControlThemeFontFamily}" FontSize="13" />
                          <TextBlock Grid.Column="2" Text="{Binding Sku}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                          <TextBlock Grid.Column="3" Text="{Binding Local}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"
                                     FontFamily="{StaticResource ContentControlThemeFontFamily}" FontSize="13" />
                          <TextBlock Grid.Column="4" Classes="status" Classes.dentro="{Binding IsDentro}"
                                     Classes.nunca="{Binding IsNeverDetected}" Text="{Binding Status}" />
                          <StackPanel Grid.Column="5" VerticalAlignment="Center">
                            <TextBlock Classes="muted" Text="{Binding UltimaDeteccao}" />
                            <TextBlock Classes="dim" FontSize="10" Text="{Binding UltimaDeteccaoDetalhe}"
                                       IsVisible="{Binding !IsNeverDetected}" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </TabItem>

      <!-- ═══════════════════════ EMBALAGENS ═══════════════════════ -->
      <TabItem Header="05 EMBALAGENS">
        <Grid ColumnDefinitions="440,*" ColumnSpacing="10" DataContext="{Binding Embalagens}" x:DataType="vm:PackageCatalogViewModel">

          <!-- Formulário -->
          <ScrollViewer Grid.Column="0">
            <c:HudBorder Classes="card" Padding="20">
              <StackPanel Spacing="8">
                <DockPanel Margin="0,0,0,6">
                  <Button DockPanel.Dock="Right" Classes="ghost" Content="NOVA" Command="{Binding NewCommand}"
                          ToolTip.Tip="Limpa o formulário para um novo cadastro" />
                  <TextBlock Classes="sectionTitle" VerticalAlignment="Center" Text="{Binding FormTitle}" />
                </DockPanel>

                <Grid ColumnDefinitions="*,150" ColumnSpacing="8">
                  <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Classes="label" Text="CÓDIGO *" />
                    <TextBox Classes="mono" Text="{Binding Codigo}" MaxLength="64" Watermark="ex.: GLT-000123"
                             ToolTip.Tip="Identificação da embalagem FÍSICA (patrimônio). Única." />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Classes="label" Text="TIPO" />
                    <TextBox Classes="mono" Text="{Binding TipoGlt}" MaxLength="32" Watermark="GLT1165"
                             ToolTip.Tip="Modelo da embalagem. Repete entre embalagens (não é chave)." />
                  </StackPanel>
                </Grid>

                <TextBlock Classes="label" Text="DESCRIÇÃO" Margin="0,6,0,0" />
                <TextBox Text="{Binding Descricao}" MaxLength="200" Watermark="ex.: GLT peças estampadas · linha 3" />

                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8" Margin="0,6,0,0">
                  <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Classes="label" Text="COMPR. mm" />
                    <TextBox Classes="mono" Text="{Binding ComprimentoMm}" MaxLength="6" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Classes="label" Text="LARG. mm" />
                    <TextBox Classes="mono" Text="{Binding LarguraMm}" MaxLength="6" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="4">
                    <TextBlock Classes="label" Text="ALT. mm" />
                    <TextBox Classes="mono" Text="{Binding AlturaMm}" MaxLength="6" />
                  </StackPanel>
                  <StackPanel Grid.Column="3" Spacing="4">
                    <TextBlock Classes="label" Text="PESO kg" />
                    <TextBox Classes="mono" Text="{Binding PesoKg}" MaxLength="10" Watermark="1,85" />
                  </StackPanel>
                </Grid>

                <TextBlock Classes="label" Text="{Binding EtiquetasTitle}" Margin="0,10,0,0" />
                <Border Classes="screen">
                  <ItemsControl ItemsSource="{Binding Etiquetas}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:PackageTagItem">
                        <Grid ColumnDefinitions="*,80,Auto" Margin="10,3">
                          <TextBlock Grid.Column="0" Classes="mono" VerticalAlignment="Center" Text="{Binding Epc}"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="1" Classes="mono dim" VerticalAlignment="Center" Text="{Binding PosicaoText}" />
                          <Button Grid.Column="2" Classes="ghost" Content="✕" Padding="8,2"
                                  Command="{Binding $parent[ItemsControl].((vm:PackageCatalogViewModel)DataContext).RemoveTagCommand}"
                                  CommandParameter="{Binding}" ToolTip.Tip="Desvincular esta etiqueta" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
                <Grid ColumnDefinitions="*,90,Auto" ColumnSpacing="6">
                  <TextBox Grid.Column="0" Classes="mono" Text="{Binding NewEpc}" Watermark="EPC (ou LER ETIQUETAS)">
                    <TextBox.KeyBindings>
                      <KeyBinding Gesture="Enter" Command="{Binding AddTagCommand}" />
                    </TextBox.KeyBindings>
                  </TextBox>
                  <TextBox Grid.Column="1" Text="{Binding NewPosicao}" MaxLength="32" Watermark="face" />
                  <Button Grid.Column="2" Content="+" Command="{Binding AddTagCommand}" ToolTip.Tip="Adicionar EPC digitado" />
                </Grid>
                <Button Classes="accent" Content="LER ETIQUETAS" Command="{Binding CaptureCommand}" HorizontalAlignment="Left"
                        ToolTip.Tip="Liga o leitor por 1,5 s. Uma tag no campo entra direto; mais de uma, você escolhe. Exige o modo PARADO; não altera o estoque." />
                <TextBlock Classes="hint" FontSize="11" TextWrapping="Wrap"
                           Text="Uma etiqueta por face (ex.: duas em faces opostas). Ler qualquer uma detecta a embalagem; a passagem gera uma movimentação só." />

                <Border Classes="screen" IsVisible="{Binding HasCapturedTags}">
                  <ListBox Classes="compact" ItemsSource="{Binding CapturedTags}" SelectedItem="{Binding SelectedCapturedTag}"
                           MaxHeight="160">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:CapturedTagItem">
                        <StackPanel Margin="10,4">
                          <TextBlock Classes="mono" Text="{Binding Epc}" />
                          <TextBlock Classes="mono dim" FontSize="11" Text="{Binding Detail}" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Border>

                <TextBlock Classes="label" Text="OBSERVAÇÃO" Margin="0,6,0,0" />
                <TextBox Text="{Binding Observacao}" MaxLength="500" AcceptsReturn="True" TextWrapping="Wrap"
                         Height="64" Watermark="opcional" />

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                  <Button Classes="accent" Content="{Binding SaveLabel}" Command="{Binding SaveCommand}" />
                  <Button Classes="ghost" Content="REMOVER EMBALAGEM" Command="{Binding DeleteCommand}"
                          IsVisible="{Binding IsEditing}"
                          ToolTip.Tip="Remove a embalagem e os vínculos. As etiquetas voltam a ser tags avulsas; histórico mantido." />
                </StackPanel>

                <TextBlock Classes="mono" FontSize="12" Text="{Binding FormMessage}" TextWrapping="Wrap"
                           Classes.error="{Binding FormMessageIsError}" />
              </StackPanel>
            </c:HudBorder>
          </ScrollViewer>

          <!-- Lista -->
          <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="10">
            <Border Grid.Row="0" Classes="card" Padding="14,10">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Classes="mono muted" FontSize="12" VerticalAlignment="Center"
                           Text="{Binding ListMessage}" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Classes="field" Text="STATUS" />
                  <ComboBox Width="140" ItemsSource="{Binding StatusFilterOptions}" SelectedIndex="{Binding StatusFilterIndex}" />
                  <TextBlock Classes="field" Text="BUSCA" Margin="8,0,0,0" />
                  <TextBox Width="200" Text="{Binding SearchText}" Watermark="código, tipo, EPC">
                    <TextBox.KeyBindings>
                      <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
                    </TextBox.KeyBindings>
                  </TextBox>
                  <Button Content="BUSCAR" Command="{Binding SearchCommand}" Classes="accent" />
                </StackPanel>
              </DockPanel>
            </Border>

            <Border Grid.Row="1" Classes="card" Padding="0">
              <Grid RowDefinitions="Auto,*">
                <Border Grid.Row="0" Classes="tableHeader">
                  <Grid ColumnDefinitions="*,80,*,160,44,100,180">
                    <TextBlock Grid.Column="0" Classes="header" Text="CÓDIGO" />
                    <TextBlock Grid.Column="1" Classes="header" Text="TIPO" />
                    <TextBlock Grid.Column="2" Classes="header" Text="DESCRIÇÃO" />
                    <TextBlock Grid.Column="3" Classes="header" Text="MEDIDAS" />
                    <TextBlock Grid.Column="4" Classes="header" Text="TAGS" />
                    <TextBlock Grid.Column="5" Classes="header" Text="STATUS" />
                    <TextBlock Grid.Column="6" Classes="header" Text="ÚLTIMA DETECÇÃO" />
                  </Grid>
                </Border>
                <ListBox Grid.Row="1" Classes="compact" ItemsSource="{Binding PackagesList}"
                         SelectedItem="{Binding SelectedPackage}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:PackageRowItem">
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,80,*,160,44,100,180">
                          <TextBlock Grid.Column="0" Text="{Binding Codigo}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                          <TextBlock Grid.Column="1" Text="{Binding Tipo}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                          <TextBlock Grid.Column="2" Text="{Binding Descricao}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"
                                     FontFamily="{StaticResource ContentControlThemeFontFamily}" FontSize="13" />
                          <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Classes="muted" FontSize="11" Text="{Binding Medidas}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="dim" FontSize="10" Text="{Binding Peso}" />
                          </StackPanel>
                          <TextBlock Grid.Column="4" Text="{Binding Etiquetas}" />
                          <TextBlock Grid.Column="5" Classes="status" Classes.dentro="{Binding IsDentro}"
                                     Classes.nunca="{Binding IsNeverDetected}" Text="{Binding Status}" />
                          <StackPanel Grid.Column="6" VerticalAlignment="Center">
                            <TextBlock Classes="muted" Text="{Binding UltimaDeteccao}" />
                            <TextBlock Classes="dim" FontSize="10" Text="{Binding UltimaDeteccaoDetalhe}"
                                       IsVisible="{Binding !IsNeverDetected}" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </TabItem>

      <!-- ═══════════════════════ CONFIGURAÇÕES ═══════════════════════ -->
      <TabItem Header="06 CONFIGURAÇÕES">
        <ScrollViewer>
          <Grid ColumnDefinitions="*,400" ColumnSpacing="10">
            <StackPanel Grid.Column="0" Spacing="10">

              <!-- Leitor: exige reaplicar -->
              <c:HudBorder Classes="card" Padding="20,16">
                <StackPanel Spacing="10">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Classes="label" VerticalAlignment="Center" Text="EXIGE APLICAR · MODO PARADO" />
                    <TextBlock Classes="sectionTitle" Text="LEITOR RFID" />
                  </DockPanel>

                  <Grid ColumnDefinitions="150,*" Margin="0,4,0,0">
                    <TextBlock Classes="field" Text="MODELO" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                      <ComboBox Width="340" ItemsSource="{Binding ReaderModels}" SelectedItem="{Binding SelectedReaderModel}">
                        <ComboBox.ItemTemplate>
                          <DataTemplate x:DataType="readers:ReaderModel">
                            <TextBlock Text="{Binding DisplayName}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <Border Classes="tag" Classes.ok="{Binding IsModelValidated}">
                        <TextBlock Text="{Binding ModelValidationText}" />
                      </Border>
                    </StackPanel>
                  </Grid>

                  <Grid ColumnDefinitions="150,*">
                    <TextBlock Classes="field" Text="TIPO" />
                    <ComboBox Grid.Column="1" Width="260"
                              ItemsSource="{Binding ReaderTypes}" SelectedIndex="{Binding ReaderTypeIndex}" />
                  </Grid>

                  <Grid ColumnDefinitions="150,*" IsVisible="{Binding IsProtocolSelectable}">
                    <TextBlock Classes="field" Text="PROTOCOLO" />
                    <ComboBox Grid.Column="1" Width="260"
                              ItemsSource="{Binding Protocols}" SelectedItem="{Binding SelectedProtocol}" />
                  </Grid>

                  <Grid ColumnDefinitions="150,*" IsVisible="{Binding IsSerialSelected}">
                    <TextBlock Classes="field" Text="PORTA · BAUD" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                      <TextBox Width="160" Classes="mono" Text="{Binding SerialPortName}" Watermark="COM3" />
                      <NumericUpDown Width="170" Minimum="300" Maximum="921600" Increment="9600"
                                     FormatString="0" Value="{Binding BaudRate}" />
                    </StackPanel>
                  </Grid>

                  <Grid ColumnDefinitions="150,*" IsVisible="{Binding IsSerialSelected}">
                    <TextBlock Classes="field" Text="PORTAS USB" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                      <ComboBox Width="160" PlaceholderText="escolher"
                                ItemsSource="{Binding AvailableSerialPorts}" SelectedItem="{Binding SelectedAvailablePort}" />
                      <Button Classes="ghost" Content="ATUALIZAR" Command="{Binding RefreshSerialPortsCommand}"
                              ToolTip.Tip="Lista de novo as portas COM (após plugar/desplugar o leitor)" />
                    </StackPanel>
                  </Grid>

                  <Grid ColumnDefinitions="150,*" IsVisible="{Binding IsNetworkSelected}">
                    <TextBlock Classes="field" Text="IP · PORTA" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                      <TextBox Width="200" Classes="mono" Text="{Binding TcpHost}" Watermark="192.168.1.100" />
                      <NumericUpDown Width="170" Minimum="1" Maximum="65535" Increment="1"
                                     FormatString="0" Value="{Binding TcpPort}" />
                    </StackPanel>
                  </Grid>

                  <Grid ColumnDefinitions="150,*" IsVisible="{Binding IsImpinjIotSelected}">
                    <TextBlock Classes="field" Text="API · USUÁRIO" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                      <TextBox Width="140" Classes="mono" Text="{Binding IotUsername}" Watermark="root" />
                      <TextBox Width="160" Classes="mono" PasswordChar="•" Text="{Binding IotPassword}" Watermark="senha" />
                      <CheckBox Content="HTTPS" IsChecked="{Binding IotUseHttps}" />
                    </StackPanel>
                  </Grid>

                  <Grid ColumnDefinitions="150,*">
                    <TextBlock Classes="field" Text="POTÊNCIA dBm" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                      <NumericUpDown Width="170" Minimum="{Binding ModelPowerMin}" Maximum="{Binding ModelPowerMax}" Increment="1"
                                     FormatString="0" Value="{Binding PowerDbm}" />
                      <TextBlock Classes="hint" Text="{Binding ModelPowerHint}" />
                    </StackPanel>
                  </Grid>

                  <Grid ColumnDefinitions="150,*">
                    <TextBlock Classes="field" Text="ANTENAS" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                      <TextBox Width="160" Classes="mono" Text="{Binding ReaderAntennasText}" Watermark="1,2" />
                      <TextBlock Classes="hint" Text="portas físicas ligadas" />
                    </StackPanel>
                  </Grid>

                  <Grid ColumnDefinitions="150,*">
                    <TextBlock Classes="field" Text="POTÊNCIA / PORTA" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                      <TextBox Width="160" Classes="mono" Text="{Binding AntennaPowerText}" Watermark="1:30; 2:27" />
                      <TextBlock Classes="hint" Text="porta:dBm · vazio = mesma potência em todas" />
                    </StackPanel>
                  </Grid>

                  <Grid ColumnDefinitions="150,*">
                    <TextBlock Classes="field" Text="DOCA ENTRADA" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                      <TextBox Width="160" Classes="mono" Text="{Binding DockEntradaText}" Watermark="ex.: 1,2" />
                      <TextBlock Classes="hint" Text="antenas cuja leitura leva a DENTRO · tecla DOCAS" />
                    </StackPanel>
                  </Grid>

                  <Grid ColumnDefinitions="150,*">
                    <TextBlock Classes="field" Text="DOCA SAÍDA" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                      <TextBox Width="160" Classes="mono" Text="{Binding DockSaidaText}" Watermark="ex.: 3,4" />
                      <TextBlock Classes="hint" Text="antenas cuja leitura leva a FORA · vazio nas duas = só manual" />
                    </StackPanel>
                  </Grid>

                  <Grid ColumnDefinitions="150,*">
                    <TextBlock Classes="field" Text="FAIXA" />
                    <CheckBox Grid.Column="1" IsChecked="{Binding EnforceAnatelBand}"
                              Content="Exigir 915–928 MHz (Anatel) · recusa leitor que não garanta a faixa" />
                  </Grid>

                  <Border Height="1" Background="{StaticResource HairlineBrush}" Margin="0,6" />

                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="APLICAR LEITOR" Classes="accent" Command="{Binding ApplyReaderCommand}" />
                    <Button Content="SALVAR COMO PADRÃO" Classes="ghost" Command="{Binding SaveReaderAsDefaultCommand}"
                            ToolTip.Tip="{Binding SettingsFilePath, StringFormat='Grava em {0}; vale na próxima abertura'}" />
                    <TextBlock VerticalAlignment="Center" Classes="mono error" FontSize="12" IsVisible="{Binding IsModeActive}"
                               Text="MODO ATIVO · PRESSIONE PARAR" />
                  </StackPanel>
                  <TextBlock Classes="mono" FontSize="12" Foreground="{StaticResource BrandSandBrush}"
                             Text="{Binding ConfigMessage}" TextWrapping="Wrap" />
                </StackPanel>
              </c:HudBorder>

              <!-- Filtro: ao vivo -->
              <c:HudBorder Classes="card" Padding="20,16">
                <StackPanel Spacing="10">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Classes="label" VerticalAlignment="Center" Text="AO VIVO · SEM RECONECTAR" />
                    <TextBlock Classes="sectionTitle" Text="FILTRO DE LEITURAS" />
                  </DockPanel>
                  <TextBlock Classes="hint"
                             Text="Descarta leituras abaixo do RSSI mínimo ou de antenas fora da lista. Corta tags distantes." />

                  <Grid ColumnDefinitions="150,*,90" Margin="0,4,0,0">
                    <TextBlock Classes="field" Text="RSSI MÍNIMO" />
                    <Slider Grid.Column="1" Minimum="-100" Maximum="-20" TickFrequency="1"
                            IsSnapToTickEnabled="True" Value="{Binding MinRssi}" />
                    <TextBlock Grid.Column="2" Classes="mono" FontSize="14" Text="{Binding MinRssiText}" FontWeight="Bold"
                               Foreground="{StaticResource BrandOrangeBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Right" />
                  </Grid>

                  <Grid ColumnDefinitions="150,*,90">
                    <TextBlock Classes="field" Text="SINAL AGORA" />
                    <c:SignalMeter Grid.Column="1" Height="26" Margin="0,4,0,0" Segments="40"
                                   Value="{Binding LastRssi}" Threshold="{Binding MinRssi}"
                                   ToolTip.Tip="RSSI das leituras atuais. À esquerda da marca laranja = descartadas." />
                    <TextBlock Grid.Column="2" Classes="mono muted" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right">
                      <Run Text="{Binding LastRssiText}" /><Run Text=" dBm" />
                    </TextBlock>
                  </Grid>

                  <Grid ColumnDefinitions="150,*">
                    <TextBlock Classes="field" Text="ANTENAS ACEITAS" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                      <TextBox Width="160" Classes="mono" Text="{Binding FilterAntennasText}" Watermark="vazio = todas" />
                      <TextBlock Classes="hint" Text="{Binding FilterMessage}" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </c:HudBorder>

              <!-- Anticolisão Gen2 -->
              <c:HudBorder Classes="card" Padding="20,16">
                <StackPanel Spacing="10">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Classes="label" VerticalAlignment="Center" Text="VALE AO APLICAR O LEITOR" />
                    <TextBlock Classes="sectionTitle" Text="ANTICOLISÃO · MUITAS TAGS" />
                  </DockPanel>
                  <TextBlock Classes="hint"
                             Text="Parâmetros Gen2 do inventário. R200/M100: Q dinâmico e troca A↔B pelo app. LLRP/Impinj IoT/R2000: Session, target e Q inicial (população estimada) vão ao leitor ao conectar; o leitor ajusta o Q." />

                  <Grid ColumnDefinitions="150,*" Margin="0,4,0,0">
                    <TextBlock Classes="field" Text="SESSION" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                      <ComboBox Width="100" ItemsSource="{Binding SessionOptions}" SelectedIndex="{Binding InventorySessionIndex}" />
                      <TextBlock Classes="hint" Text="S2/S3: tag lida fica quieta e libera slot para as outras" />
                    </StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="150,*">
                    <TextBlock Classes="field" Text="TARGET" />
                    <ComboBox Grid.Column="1" Width="200" ItemsSource="{Binding TargetOptions}" SelectedIndex="{Binding InventoryTargetIndex}" />
                  </Grid>
                  <Grid ColumnDefinitions="150,*">
                    <TextBlock Classes="field" Text="RODADA" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                      <NumericUpDown Width="140" Minimum="100" Maximum="5000" Increment="100" FormatString="0"
                                     Value="{Binding InventoryDwellMs}" />
                      <TextBlock Classes="hint" Text="ms por rodada (troca de target e recálculo de Q)" />
                    </StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="150,*">
                    <TextBlock Classes="field" Text="Q INICIAL" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                      <NumericUpDown Width="140" Minimum="0" Maximum="15" Increment="1" FormatString="0"
                                     Value="{Binding InventoryInitialQ}" />
                      <CheckBox Content="Q dinâmico (2^Q ≈ tags no campo)" IsChecked="{Binding InventoryAdaptiveQ}" />
                    </StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="150,*">
                    <TextBlock Classes="field" Text="SELECT EPC" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                      <TextBox Width="200" Classes="mono" Text="{Binding SelectEpcPrefix}" Watermark="prefixo hex · vazio = todas" />
                      <TextBlock Classes="hint" Text="Só tags com este prefixo respondem em RF" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </c:HudBorder>

              <!-- Banco de dados: vale na próxima abertura -->
              <c:HudBorder Classes="card" Padding="20,16" DataContext="{Binding Banco}" x:DataType="vm:DatabaseSettingsViewModel">
                <StackPanel Spacing="10">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Classes="label" VerticalAlignment="Center" Text="VALE NA PRÓXIMA ABERTURA" />
                    <TextBlock Classes="sectionTitle" Text="BANCO DE DADOS" />
                  </DockPanel>
                  <TextBlock Classes="hint" TextWrapping="Wrap"
                             Text="SQLite = arquivo local, zero instalação. SQL Server (Express é gratuito) = Power BI ao vivo por DirectQuery. Trocar não copia os dados do banco anterior." />

                  <Grid ColumnDefinitions="150,*" Margin="0,4,0,0">
                    <TextBlock Classes="field" Text="PROVIDER" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                      <ComboBox Width="300" ItemsSource="{Binding ProviderLabels}" SelectedIndex="{Binding ProviderIndex}" />
                      <Border Classes="tag ok">
                        <TextBlock Text="{Binding ActiveText}" />
                      </Border>
                    </StackPanel>
                  </Grid>

                  <Grid ColumnDefinitions="150,*">
                    <TextBlock Classes="field" Text="CONNECTION STRING" />
                    <TextBox Grid.Column="1" Classes="mono" TextWrapping="Wrap" AcceptsReturn="False"
                             Text="{Binding ConnectionString}" />
                  </Grid>

                  <TextBlock Classes="hint" TextWrapping="Wrap" IsVisible="{Binding IsSqlServer}"
                             Text="Prefira Integrated Security=True (login do Windows): senha de usuário SQL ficaria em texto puro no appsettings.Local.json." />

                  <Border Classes="screen" Padding="12,8">
                    <TextBlock Classes="mono" FontSize="12" TextWrapping="Wrap" Text="{Binding PowerBiText}" />
                  </Border>

                  <Border Height="1" Background="{StaticResource HairlineBrush}" Margin="0,6" />

                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="TESTAR CONEXÃO" Classes="ghost" Command="{Binding TestCommand}" />
                    <Button Content="SALVAR BANCO" Classes="accent" Command="{Binding SaveCommand}" />
                  </StackPanel>
                  <TextBlock Classes="mono muted" FontSize="12" TextWrapping="Wrap"
                             Text="{Binding Message}" Classes.error="{Binding MessageIsError}" />
                </StackPanel>
              </c:HudBorder>
            </StackPanel>

            <!-- Ficha técnica + guia de troca -->
            <StackPanel Grid.Column="1" Spacing="10">
              <c:HudBorder Classes="card" Padding="20,16">
                <StackPanel Spacing="10">
                  <TextBlock Classes="sectionTitle" Text="FICHA TÉCNICA" />
                  <TextBlock Classes="panelTitle" Text="{Binding SelectedReaderModel.DisplayName}" TextWrapping="Wrap" />
                  <Border Classes="screen" Padding="12,6">
                    <ItemsControl ItemsSource="{Binding ModelSpecs}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SpecItem">
                          <Border BorderBrush="{StaticResource RowLineBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                            <Grid ColumnDefinitions="110,*" ColumnSpacing="10">
                              <TextBlock Classes="label" Text="{Binding Label}" TextWrapping="Wrap" Margin="0,2,0,0" />
                              <TextBlock Grid.Column="1" Classes="mono" FontSize="12" Text="{Binding Value}" TextWrapping="Wrap" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Border>
                </StackPanel>
              </c:HudBorder>

              <c:HudBorder Classes="card" Padding="20,16">
                <StackPanel Spacing="8">
                  <TextBlock Classes="sectionTitle" Text="TROCA DE LEITOR" />
                  <Grid ColumnDefinitions="30,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                    <TextBlock Grid.Row="0" Classes="mono" Foreground="{StaticResource BrandOrangeBrush}" Text="01" />
                    <TextBlock Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" Text="PARAR na aba Operação." />
                    <TextBlock Grid.Row="1" Classes="mono" Foreground="{StaticResource BrandOrangeBrush}" Text="02" />
                    <TextBlock Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Text="Conectar o leitor. USB: Atualizar e escolher a porta COM." />
                    <TextBlock Grid.Row="2" Classes="mono" Foreground="{StaticResource BrandOrangeBrush}" Text="03" />
                    <TextBlock Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" Text="Escolher o modelo. Fora da lista: Personalizado + protocolo do fabricante." />
                    <TextBlock Grid.Row="3" Classes="mono" Foreground="{StaticResource BrandOrangeBrush}" Text="04" />
                    <TextBlock Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" Text="Aplicar leitor. Conferir com Ler tag na aba Cadastro." />
                    <TextBlock Grid.Row="4" Classes="mono" Foreground="{StaticResource BrandOrangeBrush}" Text="05" />
                    <TextBlock Grid.Row="4" Grid.Column="1" TextWrapping="Wrap" Text="Salvar como padrão." />
                  </Grid>
                  <Border Height="1" Background="{StaticResource HairlineBrush}" Margin="0,4" />
                  <TextBlock Classes="hint" FontSize="11"
                             Text="Protocolo novo: implementar IReaderProtocol em Infrastructure/Readers/Protocols, registrar em ReaderProtocolFactory e incluir o modelo em ReaderModelCatalog." />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="mono" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrandOrangeBrush}" Text="⚠" />
                    <TextBlock Classes="mono" FontSize="11" Foreground="{StaticResource BrandSandBrush}"
                               Text="NUNCA TRANSMITIR SEM ANTENA CONECTADA" />
                  </StackPanel>
                </StackPanel>
              </c:HudBorder>
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <!-- ══════════════ Barra de status ══════════════ -->
    <Border Grid.Row="2" Background="{StaticResource BrandInkBrush}" BorderBrush="{StaticResource HairlineBrush}"
            BorderThickness="0,1,0,0" Padding="24,6">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
        <TextBlock Grid.Column="0" Classes="mono" FontSize="11" FontWeight="Bold"
                   Foreground="{StaticResource BrandOrangeBrush}" Text="SYS&gt;" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="mono muted" FontSize="11"
                   Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="2" VerticalAlignment="Center" Classes="mono error" FontSize="11" MaxWidth="600"
                   TextTrimming="CharacterEllipsis" Text="{Binding LastError}"
                   ToolTip.Tip="{Binding LastError}" />
      </Grid>
    </Border>

    <!-- Linhas de varredura sobre tudo (não recebem clique) -->
    <c:ScanlineOverlay Grid.RowSpan="3" />

    <!-- Overlay de encerramento -->
    <Border Grid.RowSpan="3" Background="#E0101010" IsVisible="{Binding IsShuttingDown}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
        <TextBlock Text="ENCERRANDO" FontFamily="{StaticResource MonoFont}" FontSize="32" FontWeight="Bold" LetterSpacing="8"
                   Foreground="{StaticResource BrandOrangeBrush}" HorizontalAlignment="Center" />
        <TextBlock Classes="mono muted" Text="Gravando leituras pendentes no banco." HorizontalAlignment="Center" />
        <ProgressBar IsIndeterminate="True" Width="300" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
