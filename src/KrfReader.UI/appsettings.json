{
  "Reader": {
    "Type": "Mock",
    "Protocol": "AsciiLine",
    "Serial": {
      "PortName": "COM3",
      "BaudRate": 115200,
      "DataBits": 8,
      "Parity": "None",
      "StopBits": "One"
    },
    "Tcp": {
      "Host": "192.168.1.100",
      "Port": 4001,
      "ConnectTimeoutMs": 5000
    },
    "Mock": {
      "TagPopulation": 50,
      "ReadsPerSecond": 200,
      "TagsInFieldAtOnce": 8,
      "FieldChurnMs": 1500,
      "MinRssi": -85,
      "MaxRssi": -35,
      "EpcPrefix": "E28011606000",
      "Seed": null
    },
    "PowerDbm": 30,
    "Antennas": [ 1, 2 ],
    "ReconnectDelayMs": 2000
  },
  "Pipeline": {
    "DedupWindowSeconds": 5,
    "MinRssi": -70,
    "AllowedAntennas": [],
    "WorkerCount": 2,
    "QueueCapacity": 10000,
    "BatchSize": 200,
    "FlushIntervalMs": 500,
    "ShutdownTimeoutMs": 10000
  },
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=krf-reader.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  }
}
