{
  "Reader": {
    "Model": "r200",
    "Type": "Serial",
    "Protocol": "R200",
    "Serial": {
      "PortName": "COM3",
      "BaudRate": 115200,
      "DataBits": 8,
      "Parity": "None",
      "StopBits": "One"
    },
    "Tcp": {
      "Host": "192.168.1.100",
      "Port": 4001,
      "ConnectTimeoutMs": 5000
    },
    "PowerDbm": 20,
    "Antennas": [ 1 ],
    "ReconnectDelayMs": 2000
  },
  "Pipeline": {
    "DedupWindowSeconds": 5,
    "MinRssi": -70,
    "AllowedAntennas": [],
    "WorkerCount": 2,
    "QueueCapacity": 10000,
    "BatchSize": 200,
    "FlushIntervalMs": 500,
    "ShutdownTimeoutMs": 10000
  },
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=krf-reader.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  }
}
